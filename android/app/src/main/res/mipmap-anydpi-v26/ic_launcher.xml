<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <!--
      The foreground is a PNG per density rather than the vector drawable it replaced: the
      artwork is a raster file, and scaling one bitmap up to 432dp would be visibly soft.

      The master art is kept at assets/icon/ and the densities are generated by
      tools/make-icon.ps1, which frames the glyph inside the 108dp canvas's 72dp safe zone —
      the part every launcher mask is guaranteed to keep.
    -->
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
